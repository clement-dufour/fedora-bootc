{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "packageRules": [
      {
      "matchPackageNames": [
        "/^clmnt\\//"
      ],
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "overrideDatasource": "forgejo-tags",
      "registryUrls": [
          "https://forgejo.clmnt.xyz/"
      ]
    },
    {
      "matchPackageNames": [
        "quay.io/fedora/fedora-bootc"
      ],
      "pinDigests": false
    },
    {
      "matchPackageNames": [
        "quay.io/fedora/fedora-bootc"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
